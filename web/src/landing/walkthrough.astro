---
import { Image } from 'astro:assets'

import checks from '../assets/steps/checks.jpg'
import compare from '../assets/steps/compare.jpg'
import note from '../assets/steps/note.jpg'
import themes from '../assets/steps/themes.jpg'
import tweak from '../assets/steps/tweak.jpg'
import writes from '../assets/steps/writes.jpg'

const STEPS = [
  {
    title: 'Every frame is a plain HTML file',
    body: 'The moment your agent writes one, it is on the board, so it draws with the tools it already has.',
    still: writes,
    alt: 'The agent drawing the plant screen, its outline marking the frame it holds',
  },
  {
    title: 'Break a rule, and the agent hears at once',
    body: 'Clipped text, a missing font, or a color set for one theme only is flagged on the frame and reported to the agent that wrote it.',
    still: checks,
    alt: 'A finding badge on the home frame the agent is still editing',
  },
  {
    title: 'Small things, you just fix',
    body: 'Change text, color, and type by hand, picking colors from your own tokens. Only what you touch changes.',
    still: tweak,
    alt: 'The inspector open on a selected element, its fill picked from a token',
  },
  {
    title: 'Bigger things, you ask',
    body: 'Pin a note on a frame or an element, and it reaches your agent straight away. Its reply lands in the thread.',
    still: note,
    alt: 'A note thread on the landing frame, with the agent reply under the request',
  },
  {
    title: 'See exactly what it changed',
    body: 'Compare a frame with the version before the agent touched it.',
    still: compare,
    alt: 'The plant frame split between its version before and now',
  },
  {
    title: 'Every frame, in light and dark',
    body: 'Flip one frame or the whole board, and capture either theme as a PNG.',
    still: themes,
    alt: 'The landing, plant, and home frames shown in dark',
  },
]

const SIZES = '(min-width: 1024px) 680px, 100vw'
---

<section class="sec" id="walkthrough">
  <div class="wrap">
    <h2>From a file to a screen you signed off</h2>
    <p class="lead">
      One take per step, playing beside the step you are reading.
    </p>
    <div class="walk" data-walk>
      <ol class="steps">
        {STEPS.map((step, index) => (
          <li
            class:list={['step', { on: index === 0 }]}
            data-step={index}
            aria-current={index === 0 ? 'step' : undefined}
          >
            <div class="shot inline">
              <Image src={step.still} alt={step.alt} sizes={SIZES} />
            </div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
      <div class="stick" aria-hidden="true">
        <div class="shot">
          {STEPS.map((step, index) => (
            <Image
              src={step.still}
              alt=""
              sizes={SIZES}
              data-step={index}
              hidden={index !== 0}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .walk {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 64px;
    margin-top: 48px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .step {
    padding: 22px 0 22px 22px;
    border-left: 2px solid var(--line);
  }

  .step + .step {
    margin-top: 0;
  }

  .step.on {
    border-left-color: var(--accent);
  }

  .step h3 {
    margin: 0 0 6px;
    font-size: 20px;
    line-height: 1.3;
  }

  .step p {
    margin: 0;
    font-size: 16px;
  }

  .walk[data-ready] .step:not(.on) h3,
  .walk[data-ready] .step:not(.on) p {
    opacity: 0.42;
  }

  .step h3,
  .step p {
    transition: opacity 0.2s;
  }

  .stick {
    position: sticky;
    top: 32px;
    align-self: start;
  }

  .stick img[hidden] {
    display: none;
  }

  .inline {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .step h3,
    .step p {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .walk {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }

    .stick {
      display: none;
    }

    .inline {
      display: block;
      margin-bottom: 16px;
    }

    .step {
      padding: 0 0 40px;
      border-left: 0;
    }

    .walk[data-ready] .step:not(.on) h3,
    .walk[data-ready] .step:not(.on) p {
      opacity: 1;
    }
  }
</style>

<script>
  import { wireWalkthrough } from './walkthrough'

  const walk = document.querySelector<HTMLElement>('[data-walk]')
  if (walk) wireWalkthrough(walk)
</script>
