---
import Play from '../assets/icons/play.svg'
import X from '../assets/icons/x.svg'
import InstallCommand from './install-command.astro'
---

<section class="wrap" id="hero">
  <div class="pt-10 pb-12 text-center sm:pt-[72px] sm:pb-16 lg:pb-24">
    <h1>The design board your agent draws on</h1>
    <p class="lead mx-auto">
      Your agent writes each screen as a plain HTML file. Frameboard shows it
      the moment the file lands, and you review it and tweak it by hand.
    </p>
    <div class="flex justify-center">
      <InstallCommand />
    </div>
    <div class="shot group relative mt-9 sm:mt-14" data-film>
      <picture>
        <source
          media="(prefers-reduced-motion: reduce) and (prefers-color-scheme: dark)"
          srcset="/hero-still-dark.png"
          data-dark-media="(prefers-reduced-motion: reduce)"
        />
        <source
          media="(prefers-reduced-motion: reduce)"
          srcset="/hero-still.png"
        />
        <source
          media="(prefers-color-scheme: dark)"
          srcset="/hero-loop-dark.webp"
          data-dark-media="all"
          data-loop
          data-still="/hero-still-dark.png"
        />
        <img
          class="aspect-[880/587] object-cover"
          src="/hero-loop.webp"
          width="880"
          height="587"
          alt="The board canvas as an agent draws a landing page and two phone screens"
          data-loop
          data-still="/hero-still.png"
        />
      </picture>
      <button
        type="button"
        class="pause absolute right-[18px] bottom-[18px] h-[30px] cursor-pointer rounded-md border border-line bg-panel px-3 font-sans text-[13px] text-fg opacity-100 transition-opacity duration-150 group-hover:opacity-100 focus-visible:opacity-100 motion-reduce:hidden aria-pressed:opacity-100 [@media(hover:hover)]:opacity-0"
        hidden
        aria-pressed="false"
      >
        Pause
      </button>
      <a
        class="absolute top-1/2 left-1/2 flex size-14 -translate-1/2 items-center justify-center rounded-full bg-accent text-on-accent focus-visible:outline-fg sm:size-[72px]"
        href="/film.mp4"
        aria-label="Play the film, 78 seconds"
        data-play
      >
        <Play class="ml-1" aria-hidden="true" />
      </a>
      <button
        type="button"
        class="absolute top-[18px] right-[18px] inline-flex h-[30px] cursor-pointer items-center gap-1.5 rounded-md border border-line bg-panel px-2.5 font-sans text-[13px] text-fg"
        hidden
        data-close
      >
        <X aria-hidden="true" />
        Close
      </button>
    </div>
  </div>
</section>

<script>
  import { wireFilmPlayer } from './film-player'
  import { wireHeroPause } from './hero-pause'

  wireHeroPause()
  wireFilmPlayer()
</script>
