---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '../styles/global.css'

import Agent from '../landing/agent.astro'
import Close from '../landing/close.astro'
import Footer from '../landing/footer.astro'
import Hero from '../landing/hero.astro'
import Nav from '../landing/nav.astro'
import Walkthrough from '../landing/walkthrough.astro'

const description =
  'A local design board that coding agents draw on as plain HTML files, and you review and tweak.'
const canonical = new URL(Astro.url.pathname, Astro.site)
// The card a link preview shows. A preview fetches one image whatever the
// reader's theme, so switching to the dark card is this line alone:
// '/og-image-dark.png'. web/README.md names how to recapture both.
const socialCard = '/og-image.png'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Frameboard</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta property="og:site_name" content="Frameboard" />
    <meta property="og:title" content="Frameboard" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialCard, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Frameboard: the design board your agent draws on"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <Nav />
    <main>
      <Hero />
      <Walkthrough />
      <Agent />
      <Close />
    </main>
    <Footer />
  </body>
</html>
