{
  "name": "frameboard",
  "version": "0.0.1",
  "description": "A local design board that coding agents draw on as plain HTML files",
  "keywords": [
    "design",
    "board",
    "canvas",
    "html",
    "coding-agent",
    "claude-code",
    "cli"
  ],
  "homepage": "https://github.com/erclx/frameboard#readme",
  "bugs": {
    "url": "https://github.com/erclx/frameboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erclx/frameboard.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "frameboard": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && rolldown -c rolldown.config.ts",
    "preview": "node dist/cli.js serve --root test/fixtures/boards/basic --no-open --port ${PREVIEW_PORT:-4173}",
    "test": "vitest",
    "test:run": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project node",
    "test:e2e": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test",
    "test:e2e:changed": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test --only-changed",
    "test:e2e:ui": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:full": "bun scripts/verify.ts && bun run test:e2e",
    "smoke:prod": "bun e2e/screenshot.ts --check-console-clean --require-base-url",
    "prepare": "husky",
    "check": "bun scripts/verify.ts",
    "check:format": "oxfmt --check .",
    "format": "oxfmt .",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "screenshot": "PREVIEW_PORT=$(bash scripts/worktree-port.sh 4173) && export PREVIEW_PORT && bash scripts/screenshot.sh",
    "readme-screenshot": "PREVIEW_PORT=$(bash scripts/worktree-port.sh 4173) && export PREVIEW_PORT && bash scripts/readme-screenshot.sh"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5",
    "@vitest/ui": "^5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "commander": "^15.0.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.57.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "parse5": "^8.0.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.14",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vitest": "^5",
    "zod": "^4.6.7"
  }
}
